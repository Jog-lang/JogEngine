// Soft-mesh props — thin shim over jog_engine.engine.render3d (Phase 3).
import jog_engine.engine.render3d

val MESH_C0: i64 = 4294912040
val MESH_C1: i64 = 4280821980

// Demo still mutates this name; keep as alias into render3d package state.
var mesh_half: f64 = 0.28

fn mesh_sync_half() {
    r3d_softmesh_half = mesh_half
}

fn mesh_init_checker() {
    r3d_softmesh_init_checker()
}

fn mesh_set_pos(x: f64, y: f64) {
    r3d_softmesh_set_pos(x, y)
}

fn mesh_set_spin(s: f64) {
    r3d_softmesh_set_spin(s)
}

fn mesh_set_enabled(on: i64) {
    r3d_softmesh_set_enabled(on)
}

fn mesh_update(dt: f64) {
    mesh_sync_half()
    r3d_softmesh_update(dt)
}

fn mesh_draw(pixels: *byte, fb_w: i64, fb_h: i64) {
    mesh_sync_half()
    r3d_bind_camera(cam_pos_x, cam_pos_y, cam_dir_x, cam_dir_y, cam_plane_x, cam_plane_y, cam_pitch)
    r3d_bind_depth(depth_buf, depth_fb_w)
    r3d_set_present_backend(PRESENT_CPU)
    r3d_softmesh_draw(pixels, fb_w, fb_h)
}

// Second textured prop (Phase 3 multi-prop).
fn mesh_draw_prop(pixels: *byte, fb_w: i64, fb_h: i64, cx: f64, cy: f64, half: f64, spin: f64) {
    r3d_bind_camera(cam_pos_x, cam_pos_y, cam_dir_x, cam_dir_y, cam_plane_x, cam_plane_y, cam_pitch)
    r3d_bind_depth(depth_buf, depth_fb_w)
    r3d_softmesh_draw_at(pixels, fb_w, fb_h, cx, cy, half, spin)
}

fn mesh_count_color(pixels: *byte, fb_w: i64, fb_h: i64, argb: i64): i64 {
    return r3d_softmesh_count_color(pixels, fb_w, fb_h, argb)
}
