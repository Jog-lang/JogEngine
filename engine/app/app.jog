// App frame runner: clock → core_begin_frame → POLL → SIM steps → JOBS+drain → msg → PRESENT.
// Platform poll stays demo-owned (Platform iface).

import jog_engine.engine.core
import jog_engine.engine.time
import jog_engine.engine.msg
import jog_engine.engine.jobs
import jog_engine.engine.world

var app_frames: i64 = 0
var app_msg_drained: i64 = 0
var app_ready: i64 = 0

fn app_init(fixed_dt: f64): i64 {
    core_init(fixed_dt)
    timing_init()
    if (msg_init() == 0) {
        return 0
    }
    if (phase_queue_init() == 0) {
        return 0
    }
    app_frames = 0
    app_msg_drained = 0
    app_ready = 1
    return 1
}

fn app_frame_count(): i64 {
    return app_frames
}

fn app_msg_drained_count(): i64 {
    return app_msg_drained
}

fn app_reset_counters() {
    app_frames = 0
    app_msg_drained = 0
}

fn app_drain_msg() {
    while (msg_poll() != 0) {
        app_msg_drained = app_msg_drained + 1
    }
}

// One frame. Returns 1 if platform requested quit, else 0.
fn app_frame(clock: Clock, platform: Platform, runner: SystemRunner, world: *World): i64 {
    if (app_ready == 0) {
        return 0
    }
    platform.poll_events()
    if (platform.should_quit() != 0) {
        return 1
    }

    val wall_dt = clock.begin_frame()
    val steps = core_begin_frame(wall_dt)

    core_set_phase(PHASE_POLL)
    phase_queue_run(PHASE_POLL, world, wall_dt, runner)

    var i: i64 = 0
    while (i < steps) {
        core_sim_step()
        phase_queue_run(PHASE_SIM, world, core_fixed_dt_s(), runner)
        i = i + 1
    }

    core_jobs_phase()
    phase_queue_run(PHASE_JOBS, world, wall_dt, runner)
    jobs_drain()

    app_drain_msg()

    core_present_phase()
    phase_queue_run(PHASE_PRESENT, world, wall_dt, runner)

    clock.end_frame()
    app_frames = app_frames + 1
    return 0
}
