// AABB / circle tests + uniform grid broadphase (Phase 2).
// Contacts post to engine.msg (MSG_CONTACT). Scalar APIs only.

import jog_engine.engine.msg

val COLL_KIND_AABB: i64 = 1
val COLL_KIND_CIRCLE: i64 = 2
val COLL_KIND_AABB_CIRCLE: i64 = 3

val COLL_GRID_CAP: i64 = 256
val COLL_PAIR_CAP: i64 = 128

var coll_cell: f64 = 32.0
var coll_origin_x: f64 = 0.0
var coll_origin_y: f64 = 0.0
var coll_cols: i64 = 16
var coll_rows: i64 = 16

// Body SoA (id, kind, x,y,w,h or r in w).
var coll_n: i64 = 0
var coll_id: *byte = null
var coll_kind: *byte = null
var coll_x: *byte = null
var coll_y: *byte = null
var coll_w: *byte = null
var coll_h: *byte = null

// Grid lists: for each cell, count + up to 8 body indices (packed as i64).
val COLL_CELL_SLOTS: i64 = 8
var coll_cell_count: *byte = null
var coll_cell_ids: *byte = null

fn coll_poke64(p: *byte, i: i64, v: i64) {
    val off = i * 8
    p[off] = v & 255
    p[off + 1] = (v >> 8) & 255
    p[off + 2] = (v >> 16) & 255
    p[off + 3] = (v >> 24) & 255
    p[off + 4] = (v >> 32) & 255
    p[off + 5] = (v >> 40) & 255
    p[off + 6] = (v >> 48) & 255
    p[off + 7] = (v >> 56) & 255
}

fn coll_peek64(p: *byte, i: i64): i64 {
    val off = i * 8
    val b0 = p[off] & 255
    val b1 = p[off + 1] & 255
    val b2 = p[off + 2] & 255
    val b3 = p[off + 3] & 255
    val b4 = p[off + 4] & 255
    val b5 = p[off + 5] & 255
    val b6 = p[off + 6] & 255
    val b7 = p[off + 7] & 255
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24) + (b4 << 32) + (b5 << 40) + (b6 << 48) + (b7 << 56)
}

fn coll_pokef(p: *byte, i: i64, v: f64) {
    // Store f64 bits via integer transmute is Friction; store as scaled i64 milli-units.
    // Keep a float literal in the mul chain (load*const can lower to imul).
    // Callers should keep world coords non-negative (unsigned poke64 rebuild).
    val milli = (v * 1.0 * 1000.0) as i64
    if (milli < 0) {
        coll_poke64(p, i, 0)
        return
    }
    coll_poke64(p, i, milli)
}

fn coll_peekf(p: *byte, i: i64): f64 {
    val milli = coll_peek64(p, i)
    return (milli as f64) * 1.0 / 1000.0
}

fn coll_aabb_overlap(ax: f64, ay: f64, aw: f64, ah: f64, bx: f64, by: f64, bw: f64, bh: f64): i64 {
    if (ax * 1.0 + aw <= bx) {
        return 0
    }
    if (bx * 1.0 + bw <= ax) {
        return 0
    }
    if (ay * 1.0 + ah <= by) {
        return 0
    }
    if (by * 1.0 + bh <= ay) {
        return 0
    }
    return 1
}

fn coll_circle_overlap(ax: f64, ay: f64, ar: f64, bx: f64, by: f64, br: f64): i64 {
    val dx = ax - bx
    val dy = ay - by
    val rr = ar + br
    if (dx * dx + dy * dy <= rr * rr) {
        return 1
    }
    return 0
}

fn coll_aabb_circle(ax: f64, ay: f64, aw: f64, ah: f64, cx: f64, cy: f64, cr: f64): i64 {
    var nx = cx
    var ny = cy
    if (nx < ax) {
        nx = ax
    }
    if (nx > ax + aw) {
        nx = ax + aw
    }
    if (ny < ay) {
        ny = ay
    }
    if (ny > ay + ah) {
        ny = ay + ah
    }
    val dx = cx - nx
    val dy = cy - ny
    if (dx * dx + dy * dy <= cr * cr) {
        return 1
    }
    return 0
}

fn coll_init(cell: f64, origin_x: f64, origin_y: f64, cols: i64, rows: i64): i64 {
    coll_cell = cell
    if (coll_cell < 1.0) {
        coll_cell = 1.0
    }
    coll_origin_x = origin_x
    coll_origin_y = origin_y
    coll_cols = cols
    coll_rows = rows
    if (coll_cols < 1) {
        coll_cols = 1
    }
    if (coll_rows < 1) {
        coll_rows = 1
    }
    val cells = coll_cols * coll_rows
    if (coll_id == null) {
        coll_id = alloc(COLL_GRID_CAP * 8)
        coll_kind = alloc(COLL_GRID_CAP * 8)
        coll_x = alloc(COLL_GRID_CAP * 8)
        coll_y = alloc(COLL_GRID_CAP * 8)
        coll_w = alloc(COLL_GRID_CAP * 8)
        coll_h = alloc(COLL_GRID_CAP * 8)
        coll_cell_count = alloc(cells * 8)
        coll_cell_ids = alloc(cells * COLL_CELL_SLOTS * 8)
        if (coll_id == null || coll_kind == null || coll_x == null || coll_y == null || coll_w == null || coll_h == null || coll_cell_count == null || coll_cell_ids == null) {
            return 0
        }
    }
    coll_n = 0
    coll_grid_clear()
    return 1
}

fn coll_grid_clear() {
    if (coll_cell_count == null) {
        return
    }
    val cells = coll_cols * coll_rows
    var i: i64 = 0
    while (i < cells) {
        coll_poke64(coll_cell_count, i, 0)
        i = i + 1
    }
    coll_n = 0
}

fn coll_cell_index(cx: i64, cy: i64): i64 {
    var x = cx
    var y = cy
    if (x < 0) {
        x = 0
    }
    if (y < 0) {
        y = 0
    }
    if (x >= coll_cols) {
        x = coll_cols - 1
    }
    if (y >= coll_rows) {
        y = coll_rows - 1
    }
    return y * coll_cols + x
}

fn coll_grid_insert_aabb(id: i64, x: f64, y: f64, w: f64, h: f64): i64 {
    if (coll_n >= COLL_GRID_CAP) {
        return 0
    }
    val bi = coll_n
    coll_poke64(coll_id, bi, id)
    coll_poke64(coll_kind, bi, COLL_KIND_AABB)
    coll_pokef(coll_x, bi, x)
    coll_pokef(coll_y, bi, y)
    coll_pokef(coll_w, bi, w)
    coll_pokef(coll_h, bi, h)
    coll_n = coll_n + 1

    val x0 = ((x - coll_origin_x) / coll_cell) as i64
    val y0 = ((y - coll_origin_y) / coll_cell) as i64
    val x1 = ((x + w - coll_origin_x) / coll_cell) as i64
    val y1 = ((y + h - coll_origin_y) / coll_cell) as i64
    var cy = y0
    while (cy <= y1) {
        var cx = x0
        while (cx <= x1) {
            val ci = coll_cell_index(cx, cy)
            val n = coll_peek64(coll_cell_count, ci)
            if (n < COLL_CELL_SLOTS) {
                coll_poke64(coll_cell_ids, ci * COLL_CELL_SLOTS + n, bi)
                coll_poke64(coll_cell_count, ci, n + 1)
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
    return 1
}

fn coll_grid_insert_circle(id: i64, x: f64, y: f64, r: f64): i64 {
    if (coll_n >= COLL_GRID_CAP) {
        return 0
    }
    val bi = coll_n
    coll_poke64(coll_id, bi, id)
    coll_poke64(coll_kind, bi, COLL_KIND_CIRCLE)
    coll_pokef(coll_x, bi, x)
    coll_pokef(coll_y, bi, y)
    coll_pokef(coll_w, bi, r)
    coll_pokef(coll_h, bi, r)
    coll_n = coll_n + 1

    val x0 = ((x - r - coll_origin_x) / coll_cell) as i64
    val y0 = ((y - r - coll_origin_y) / coll_cell) as i64
    val x1 = ((x + r - coll_origin_x) / coll_cell) as i64
    val y1 = ((y + r - coll_origin_y) / coll_cell) as i64
    var cy = y0
    while (cy <= y1) {
        var cx = x0
        while (cx <= x1) {
            val ci = coll_cell_index(cx, cy)
            val n = coll_peek64(coll_cell_count, ci)
            if (n < COLL_CELL_SLOTS) {
                coll_poke64(coll_cell_ids, ci * COLL_CELL_SLOTS + n, bi)
                coll_poke64(coll_cell_count, ci, n + 1)
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
    return 1
}

fn coll_bodies_overlap(i: i64, j: i64): i64 {
    val ki = coll_peek64(coll_kind, i)
    val kj = coll_peek64(coll_kind, j)
    val ix = coll_peekf(coll_x, i)
    val iy = coll_peekf(coll_y, i)
    val iw = coll_peekf(coll_w, i)
    val ih = coll_peekf(coll_h, i)
    val jx = coll_peekf(coll_x, j)
    val jy = coll_peekf(coll_y, j)
    val jw = coll_peekf(coll_w, j)
    val jh = coll_peekf(coll_h, j)
    if (ki == COLL_KIND_AABB && kj == COLL_KIND_AABB) {
        return coll_aabb_overlap(ix, iy, iw, ih, jx, jy, jw, jh)
    }
    if (ki == COLL_KIND_CIRCLE && kj == COLL_KIND_CIRCLE) {
        return coll_circle_overlap(ix, iy, iw, jx, jy, jw)
    }
    if (ki == COLL_KIND_AABB && kj == COLL_KIND_CIRCLE) {
        return coll_aabb_circle(ix, iy, iw, ih, jx, jy, jw)
    }
    if (ki == COLL_KIND_CIRCLE && kj == COLL_KIND_AABB) {
        return coll_aabb_circle(jx, jy, jw, jh, ix, iy, iw)
    }
    return 0
}

// Query grid cells; post unique overlapping pairs as MSG_CONTACT. Returns pair count posted.
fn coll_grid_query_pairs(): i64 {
    var posted: i64 = 0
    val cells = coll_cols * coll_rows
    var ci: i64 = 0
    while (ci < cells) {
        val n = coll_peek64(coll_cell_count, ci)
        var a: i64 = 0
        while (a < n) {
            val ia = coll_peek64(coll_cell_ids, ci * COLL_CELL_SLOTS + a)
            var b = a + 1
            while (b < n) {
                val ib = coll_peek64(coll_cell_ids, ci * COLL_CELL_SLOTS + b)
                if (ia != ib && coll_bodies_overlap(ia, ib) != 0) {
                    val ida = coll_peek64(coll_id, ia)
                    val idb = coll_peek64(coll_id, ib)
                    // Order ids for crude de-dupe across cells.
                    var lo = ida
                    var hi = idb
                    if (lo > hi) {
                        lo = idb
                        hi = ida
                    }
                    msg_push_contact(lo, hi, COLL_KIND_AABB)
                    posted = posted + 1
                    if (posted >= COLL_PAIR_CAP) {
                        return posted
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
        ci = ci + 1
    }
    return posted
}

// --- AABB3 grid (Phase: dust2 FPS). Separate SoA from 2D; contacts reuse MSG_CONTACT. ---

val COLL_KIND_AABB3: i64 = 4
val COLL3_GRID_CAP: i64 = 8192
val COLL3_PAIR_CAP: i64 = 256
val COLL3_CELL_SLOTS: i64 = 8

var coll3_cell: f64 = 4.0
var coll3_origin_x: f64 = 0.0
var coll3_origin_y: f64 = 0.0
var coll3_origin_z: f64 = 0.0
var coll3_cols: i64 = 16
var coll3_rows: i64 = 16
var coll3_layers: i64 = 8

var coll3_n: i64 = 0
var coll3_id: *byte = null
var coll3_kind: *byte = null
var coll3_x: *byte = null
var coll3_y: *byte = null
var coll3_z: *byte = null
var coll3_w: *byte = null
var coll3_h: *byte = null
var coll3_d: *byte = null
var coll3_cell_count: *byte = null
var coll3_cell_ids: *byte = null

// Scratch A/B boxes for loaders; overlap uses the honest 12-float ABI (SysV stack pad fixed).
var coll3_qa_x: f64 = 0.0
var coll3_qa_y: f64 = 0.0
var coll3_qa_z: f64 = 0.0
var coll3_qa_w: f64 = 0.0
var coll3_qa_h: f64 = 0.0
var coll3_qa_d: f64 = 0.0
var coll3_qb_x: f64 = 0.0
var coll3_qb_y: f64 = 0.0
var coll3_qb_z: f64 = 0.0
var coll3_qb_w: f64 = 0.0
var coll3_qb_h: f64 = 0.0
var coll3_qb_d: f64 = 0.0

fn coll_aabb3_a_x(v: f64) { coll3_qa_x = v }
fn coll_aabb3_a_y(v: f64) { coll3_qa_y = v }
fn coll_aabb3_a_z(v: f64) { coll3_qa_z = v }
fn coll_aabb3_a_w(v: f64) { coll3_qa_w = v }
fn coll_aabb3_a_h(v: f64) { coll3_qa_h = v }
fn coll_aabb3_a_d(v: f64) { coll3_qa_d = v }
fn coll_aabb3_b_x(v: f64) { coll3_qb_x = v }
fn coll_aabb3_b_y(v: f64) { coll3_qb_y = v }
fn coll_aabb3_b_z(v: f64) { coll3_qb_z = v }
fn coll_aabb3_b_w(v: f64) { coll3_qb_w = v }
fn coll_aabb3_b_h(v: f64) { coll3_qb_h = v }
fn coll_aabb3_b_d(v: f64) { coll3_qb_d = v }

fn coll_aabb3_set_a(x: f64, y: f64, z: f64, w: f64, h: f64, d: f64) {
    coll_aabb3_a_x(x)
    coll_aabb3_a_y(y)
    coll_aabb3_a_z(z)
    coll_aabb3_a_w(w)
    coll_aabb3_a_h(h)
    coll_aabb3_a_d(d)
}

fn coll_aabb3_set_b(x: f64, y: f64, z: f64, w: f64, h: f64, d: f64) {
    coll_aabb3_b_x(x)
    coll_aabb3_b_y(y)
    coll_aabb3_b_z(z)
    coll_aabb3_b_w(w)
    coll_aabb3_b_h(h)
    coll_aabb3_b_d(d)
}

// Honest 12×f64 overlap (Jog↔Jog stack args; SysV 16-byte pad in JogCompiler #43).
fn coll_aabb3_overlap(ax: f64, ay: f64, az: f64, aw: f64, ah: f64, ad: f64, bx: f64, by: f64, bz: f64, bw: f64, bh: f64, bd: f64): i64 {
    if (ax + aw <= bx) {
        return 0
    }
    if (bx + bw <= ax) {
        return 0
    }
    if (ay + ah <= by) {
        return 0
    }
    if (by + bh <= ay) {
        return 0
    }
    if (az + ad <= bz) {
        return 0
    }
    if (bz + bd <= az) {
        return 0
    }
    return 1
}

fn coll_aabb3_load_body_a(i: i64) {
    coll_aabb3_a_x(coll_peekf(coll3_x, i))
    coll_aabb3_a_y(coll_peekf(coll3_y, i))
    coll_aabb3_a_z(coll_peekf(coll3_z, i))
    coll_aabb3_a_w(coll_peekf(coll3_w, i))
    coll_aabb3_a_h(coll_peekf(coll3_h, i))
    coll_aabb3_a_d(coll_peekf(coll3_d, i))
}

fn coll_aabb3_load_body_b(i: i64) {
    coll_aabb3_b_x(coll_peekf(coll3_x, i))
    coll_aabb3_b_y(coll_peekf(coll3_y, i))
    coll_aabb3_b_z(coll_peekf(coll3_z, i))
    coll_aabb3_b_w(coll_peekf(coll3_w, i))
    coll_aabb3_b_h(coll_peekf(coll3_h, i))
    coll_aabb3_b_d(coll_peekf(coll3_d, i))
}

fn coll_aabb3_overlap_ab(): i64 {
    return coll_aabb3_overlap(
        coll3_qa_x, coll3_qa_y, coll3_qa_z, coll3_qa_w, coll3_qa_h, coll3_qa_d,
        coll3_qb_x, coll3_qb_y, coll3_qb_z, coll3_qb_w, coll3_qb_h, coll3_qb_d
    )
}

fn coll_init3(cell: f64, origin_x: f64, origin_y: f64, origin_z: f64, cols: i64, rows: i64, layers: i64): i64 {
    coll3_cell = cell
    if (coll3_cell < 1.0) {
        coll3_cell = 1.0
    }
    coll3_origin_x = origin_x
    coll3_origin_y = origin_y
    coll3_origin_z = origin_z
    coll3_cols = cols
    coll3_rows = rows
    coll3_layers = layers
    if (coll3_cols < 1) {
        coll3_cols = 1
    }
    if (coll3_rows < 1) {
        coll3_rows = 1
    }
    if (coll3_layers < 1) {
        coll3_layers = 1
    }
    val cells = coll3_cols * coll3_rows * coll3_layers
    if (coll3_id == null) {
        coll3_id = alloc(COLL3_GRID_CAP * 8)
        coll3_kind = alloc(COLL3_GRID_CAP * 8)
        coll3_x = alloc(COLL3_GRID_CAP * 8)
        coll3_y = alloc(COLL3_GRID_CAP * 8)
        coll3_z = alloc(COLL3_GRID_CAP * 8)
        coll3_w = alloc(COLL3_GRID_CAP * 8)
        coll3_h = alloc(COLL3_GRID_CAP * 8)
        coll3_d = alloc(COLL3_GRID_CAP * 8)
        coll3_cell_count = alloc(cells * 8)
        coll3_cell_ids = alloc(cells * COLL3_CELL_SLOTS * 8)
        if (coll3_id == null || coll3_kind == null || coll3_x == null || coll3_y == null || coll3_z == null || coll3_w == null || coll3_h == null || coll3_d == null || coll3_cell_count == null || coll3_cell_ids == null) {
            return 0
        }
    }
    coll3_n = 0
    coll_grid3_clear()
    return 1
}

fn coll_grid3_clear() {
    if (coll3_cell_count == null) {
        return
    }
    val cells = coll3_cols * coll3_rows * coll3_layers
    var i: i64 = 0
    while (i < cells) {
        coll_poke64(coll3_cell_count, i, 0)
        i = i + 1
    }
    coll3_n = 0
}

fn coll3_cell_index(cx: i64, cy: i64, cz: i64): i64 {
    var x = cx
    var y = cy
    var z = cz
    if (x < 0) {
        x = 0
    }
    if (y < 0) {
        y = 0
    }
    if (z < 0) {
        z = 0
    }
    if (x >= coll3_cols) {
        x = coll3_cols - 1
    }
    if (y >= coll3_rows) {
        y = coll3_rows - 1
    }
    if (z >= coll3_layers) {
        z = coll3_layers - 1
    }
    return (z * coll3_rows + y) * coll3_cols + x
}

fn coll_grid_insert_aabb3(id: i64, x: f64, y: f64, z: f64, w: f64, h: f64, d: f64): i64 {
    if (coll3_n >= COLL3_GRID_CAP) {
        return 0
    }
    val bi = coll3_n
    coll_poke64(coll3_id, bi, id)
    coll_poke64(coll3_kind, bi, COLL_KIND_AABB3)
    coll_pokef(coll3_x, bi, x)
    coll_pokef(coll3_y, bi, y)
    coll_pokef(coll3_z, bi, z)
    coll_pokef(coll3_w, bi, w)
    coll_pokef(coll3_h, bi, h)
    coll_pokef(coll3_d, bi, d)
    coll3_n = coll3_n + 1

    val x0 = ((x - coll3_origin_x) / coll3_cell) as i64
    val y0 = ((y - coll3_origin_y) / coll3_cell) as i64
    val z0 = ((z - coll3_origin_z) / coll3_cell) as i64
    val x1 = ((x + w - coll3_origin_x) / coll3_cell) as i64
    val y1 = ((y + h - coll3_origin_y) / coll3_cell) as i64
    val z1 = ((z + d - coll3_origin_z) / coll3_cell) as i64
    var cz = z0
    while (cz <= z1) {
        var cy = y0
        while (cy <= y1) {
            var cx = x0
            while (cx <= x1) {
                val ci = coll3_cell_index(cx, cy, cz)
                val n = coll_peek64(coll3_cell_count, ci)
                if (n < COLL3_CELL_SLOTS) {
                    coll_poke64(coll3_cell_ids, ci * COLL3_CELL_SLOTS + n, bi)
                    coll_poke64(coll3_cell_count, ci, n + 1)
                }
                cx = cx + 1
            }
            cy = cy + 1
        }
        cz = cz + 1
    }
    return 1
}

fn coll3_body_get_x(i: i64): f64 {
    return coll_peekf(coll3_x, i)
}

fn coll3_body_get_y(i: i64): f64 {
    return coll_peekf(coll3_y, i)
}

fn coll3_body_get_z(i: i64): f64 {
    return coll_peekf(coll3_z, i)
}

fn coll3_body_get_w(i: i64): f64 {
    return coll_peekf(coll3_w, i)
}

fn coll3_body_get_h(i: i64): f64 {
    return coll_peekf(coll3_h, i)
}

fn coll3_body_get_d(i: i64): f64 {
    return coll_peekf(coll3_d, i)
}

fn coll3_body_count(): i64 {
    return coll3_n
}

fn coll3_bodies_overlap(i: i64, j: i64): i64 {
    coll_aabb3_load_body_a(i)
    coll_aabb3_load_body_b(j)
    return coll_aabb3_overlap_ab()
}

fn coll_grid3_query_pairs(): i64 {
    var posted: i64 = 0
    val cells = coll3_cols * coll3_rows * coll3_layers
    var ci: i64 = 0
    while (ci < cells) {
        val n = coll_peek64(coll3_cell_count, ci)
        var a: i64 = 0
        while (a < n) {
            val ia = coll_peek64(coll3_cell_ids, ci * COLL3_CELL_SLOTS + a)
            var b = a + 1
            while (b < n) {
                val ib = coll_peek64(coll3_cell_ids, ci * COLL3_CELL_SLOTS + b)
                if (ia != ib && coll3_bodies_overlap(ia, ib) != 0) {
                    val ida = coll_peek64(coll3_id, ia)
                    val idb = coll_peek64(coll3_id, ib)
                    var lo = ida
                    var hi = idb
                    if (lo > hi) {
                        lo = idb
                        hi = ida
                    }
                    msg_push_contact(lo, hi, COLL_KIND_AABB3)
                    posted = posted + 1
                    if (posted >= COLL3_PAIR_CAP) {
                        return posted
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
        ci = ci + 1
    }
    return posted
}
