// engine.assets — bump-safe CPU texture helpers (Phase 1 lift from raycaster).
// ARGB8888 little-endian in memory (B,G,R,A). Scalar + *byte only (no struct returns).
// Phase 4: IO Dispatcher loads + generation cancel via engine.jobs / engine.msg.
import std.math
import jog_engine.engine.jobs
import jog_engine.engine.msg

extern {
    fn fopen(path: *byte, mode: *byte): *byte
    fn fread(ptr: *byte, size: u64, nmemb: u64, stream: *byte): u64
    fn fwrite(ptr: *byte, size: u64, nmemb: u64, stream: *byte): u64
    fn fclose(stream: *byte): i32
}

// Last successful load size (PPM / ARGB atlas).
var tex_w: i64 = 0
var tex_h: i64 = 0

fn tex_poke32(p: *byte, off: i64, v: i64) {
    p[off] = v & 255
    p[off + 1] = (v >> 8) & 255
    p[off + 2] = (v >> 16) & 255
    p[off + 3] = (v >> 24) & 255
}

fn tex_peek32(p: *byte, off: i64): i64 {
    // Mask — Jog byte loads may be sign-extended into i64.
    val b0 = p[off] & 255
    val b1 = p[off + 1] & 255
    val b2 = p[off + 2] & 255
    val b3 = p[off + 3] & 255
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)
}

// Wrap into [0, 1).
fn tex_wrap01(t: f64): f64 {
    var x = t - floor(t)
    if (x < 0.0) {
        x = x + 1.0
    }
    if (x >= 1.0) {
        x = 0.0
    }
    return x
}

// Nearest-neighbor sample; u,v typically [0,1], wrapped.
fn tex_sample(pixels: *byte, w: i64, h: i64, u: f64, v: f64): i64 {
    if (pixels == null || w <= 0 || h <= 0) {
        return 0
    }
    val uu = tex_wrap01(u)
    val vv = tex_wrap01(v)
    var tx = floor(uu * (w as f64)) as i64
    var ty = floor(vv * (h as f64)) as i64
    if (tx < 0) {
        tx = 0
    }
    if (ty < 0) {
        ty = 0
    }
    if (tx >= w) {
        tx = w - 1
    }
    if (ty >= h) {
        ty = h - 1
    }
    return tex_peek32(pixels, (ty * w + tx) * 4)
}

// Darken RGB for classic raycaster side shading (keep alpha).
fn tex_shade(argb: i64, side: i64): i64 {
    if (side == 0) {
        return argb
    }
    val a = argb & 4278190080
    val r = ((argb >> 16) & 255) >> 1
    val g = ((argb >> 8) & 255) >> 1
    val b = (argb & 255) >> 1
    return a + (r << 16) + (g << 8) + b
}

// Procedural checker atlas (in-repo bake without shipping bytes).
fn tex_fill_checker(pixels: *byte, w: i64, h: i64, c0: i64, c1: i64, cell: i64) {
    var y: i64 = 0
    while (y < h) {
        var x: i64 = 0
        while (x < w) {
            var use1 = 0
            if (cell > 0) {
                val cx = x / cell
                val cy = y / cell
                if (((cx + cy) & 1) != 0) {
                    use1 = 1
                }
            }
            var c = c0
            if (use1 != 0) {
                c = c1
            }
            tex_poke32(pixels, (y * w + x) * 4, c)
            x = x + 1
        }
        y = y + 1
    }
    tex_w = w
    tex_h = h
}

fn tex_is_ws(b: i64): i64 {
    if (b == 32 || b == 9 || b == 10 || b == 13) {
        return 1
    }
    return 0
}

// Skip PPM whitespace and `#` comment lines. Returns new index or -1.
fn tex_ppm_skip(buf: *byte, n: i64, start: i64): i64 {
    var i = start
    while (i < n) {
        val b = buf[i]
        if (b == 35) {
            while (i < n && buf[i] != 10) {
                i = i + 1
            }
            if (i < n) {
                i = i + 1
            }
        } else {
            if (tex_is_ws(b) != 0) {
                i = i + 1
            } else {
                return i
            }
        }
    }
    return 0 - 1
}

fn tex_ppm_read_int(buf: *byte, n: i64, start: i64): i64 {
    // Writes parsed value into tex_parse_val; returns next index or -1.
    var i = tex_ppm_skip(buf, n, start)
    if (i < 0) {
        return 0 - 1
    }
    var v: i64 = 0
    var digits = 0
    while (i < n) {
        val b = buf[i]
        if (b < 48 || b > 57) {
            break
        }
        v = v * 10 + (b - 48)
        digits = digits + 1
        i = i + 1
    }
    if (digits == 0) {
        return 0 - 1
    }
    tex_parse_val = v
    return i
}

var tex_parse_val: i64 = 0

// Decode P6 bytes already in memory into ARGB out (cap = out bytes).
// Returns 0 on success; sets tex_w / tex_h.
fn tex_decode_ppm(buf: *byte, n: i64, out: *byte, out_cap: i64): i64 {
    if (buf == null || out == null || n < 8) {
        return 0 - 1
    }
    if (buf[0] != 80 || buf[1] != 54) {
        return 0 - 2
    }
    var i = 2
    i = tex_ppm_read_int(buf, n, i)
    if (i < 0) {
        return 0 - 3
    }
    val w = tex_parse_val
    i = tex_ppm_read_int(buf, n, i)
    if (i < 0) {
        return 0 - 3
    }
    val h = tex_parse_val
    i = tex_ppm_read_int(buf, n, i)
    if (i < 0) {
        return 0 - 3
    }
    val maxv = tex_parse_val
    if (w <= 0 || h <= 0 || maxv != 255) {
        return 0 - 4
    }
    i = tex_ppm_skip(buf, n, i)
    if (i < 0) {
        return 0 - 5
    }
    // Single whitespace separator before binary payload.
    if (tex_is_ws(buf[i]) != 0) {
        i = i + 1
    }
    val need = w * h * 3
    if (i + need > n) {
        return 0 - 6
    }
    val out_need = w * h * 4
    if (out_need > out_cap) {
        return 0 - 7
    }
    var p = 0
    var o = 0
    while (p < need) {
        val r = buf[i + p]
        val g = buf[i + p + 1]
        val b = buf[i + p + 2]
        // AARRGGBB
        val argb = 4278190080 + (r << 16) + (g << 8) + b
        tex_poke32(out, o, argb)
        p = p + 3
        o = o + 4
    }
    tex_w = w
    tex_h = h
    return 0
}

fn tex_load_file(path: *byte, dest: *byte, cap: i64): i64 {
    // Returns bytes read into dest, or -1 on failure.
    val f = fopen(path, c"rb")
    if (f == null) {
        return 0 - 1
    }
    val n = fread(dest, 1, cap as u64, f)
    fclose(f)
    return n as i64
}

// Load P6 PPM from path into ARGB out. Returns 0 on success.
fn tex_load_ppm(path: *byte, out: *byte, out_cap: i64): i64 {
    // Cap raw file read; 64 KiB is enough for demo atlases.
    val raw_cap: i64 = 65536
    val raw = alloc(raw_cap)
    if (raw == null) {
        return 0 - 10
    }
    val n = tex_load_file(path, raw, raw_cap)
    if (n <= 0) {
        return 0 - 11
    }
    return tex_decode_ppm(raw, n, out, out_cap)
}

// Baked atlas: magic "ARGB" + u32le w + u32le h + w*h ARGB8888 LE pixels.
fn tex_decode_argb(buf: *byte, n: i64, out: *byte, out_cap: i64): i64 {
    if (buf == null || out == null || n < 12) {
        return 0 - 1
    }
    if (buf[0] != 65 || buf[1] != 82 || buf[2] != 71 || buf[3] != 66) {
        return 0 - 2
    }
    val w = tex_peek32(buf, 4)
    val h = tex_peek32(buf, 8)
    if (w <= 0 || h <= 0) {
        return 0 - 3
    }
    val pix_bytes = w * h * 4
    if (12 + pix_bytes > n) {
        return 0 - 4
    }
    if (pix_bytes > out_cap) {
        return 0 - 5
    }
    var i: i64 = 0
    while (i < pix_bytes) {
        out[i] = buf[12 + i]
        i = i + 1
    }
    tex_w = w
    tex_h = h
    return 0
}

fn tex_load_argb(path: *byte, out: *byte, out_cap: i64): i64 {
    val raw_cap: i64 = 65536
    val raw = alloc(raw_cap)
    if (raw == null) {
        return 0 - 10
    }
    val n = tex_load_file(path, raw, raw_cap)
    if (n <= 0) {
        return 0 - 11
    }
    return tex_decode_argb(raw, n, out, out_cap)
}

// Blit one sampled texel into a software FB (ARGB8888).
fn tex_put_fb(fb: *byte, fb_w: i64, x: i64, y: i64, argb: i64) {
    tex_poke32(fb, (y * fb_w + x) * 4, argb)
}

// --- Async PPM load on dispatcher_io (Phase 4) ---
// One in-flight request; completions land in package state then msg_push_asset on poll.

val ASSET_IDLE: i64 = 0
val ASSET_PENDING: i64 = 1
val ASSET_READY: i64 = 2
val ASSET_ERROR: i64 = 3
val ASSET_STALE: i64 = 4

var asset_status: i64 = 0
var asset_slot: i64 = 0
var asset_gen: i64 = 0
var asset_out: *byte = null
var asset_out_cap: i64 = 0
var asset_path: *byte = null
var asset_result: i64 = 0
var asset_nbytes: i64 = 0

fn assets_status(): i64 {
    return asset_status
}

fn assets_cancel_pending() {
    jobs_bump_io_generation()
    if (asset_status == ASSET_PENDING) {
        asset_status = ASSET_STALE
    }
}

fn assets_io_worker(arg: *byte) {
    val gen = asset_gen
    val path = asset_path
    val out = asset_out
    val cap = asset_out_cap
    var rc: i64 = 0 - 1
    if (path != null && out != null && cap > 0) {
        rc = tex_load_ppm(path, out, cap)
    }
    if (jobs_io_generation_live(gen) == 0) {
        asset_status = ASSET_STALE
        return
    }
    asset_result = rc
    if (rc == 0) {
        asset_nbytes = tex_w * tex_h * 4
        asset_status = ASSET_READY
    } else {
        asset_nbytes = 0
        asset_status = ASSET_ERROR
    }
}

// Kick an async PPM decode on the IO Dispatcher. Returns 1 if started, 0 if busy/serial-sync-done.
fn assets_request_ppm(slot: i64, path: *byte, out: *byte, out_cap: i64): i64 {
    if (asset_status == ASSET_PENDING) {
        return 0
    }
    asset_slot = slot
    asset_path = path
    asset_out = out
    asset_out_cap = out_cap
    asset_result = 0
    asset_nbytes = 0
    if (jobs_io_ok() == 0) {
        // Serial / no IO pool: load on caller thread.
        asset_gen = jobs_io_generation_id()
        asset_status = ASSET_PENDING
        assets_io_worker(null)
        return 1
    }
    asset_gen = jobs_io_generation_id()
    asset_status = ASSET_PENDING
    val io = dispatcher_get(jobs_io_dispatcher_id())
    with (io) {
        go(assets_io_worker, null)
    }
    return 1
}

// After jobs_drain: push MSG_ASSET for completed (or stale/error) requests. Returns 1 if a message was pushed.
fn assets_poll(): i64 {
    if (asset_status == ASSET_PENDING || asset_status == ASSET_IDLE) {
        return 0
    }
    val st = asset_status
    val slot = asset_slot
    val gen = asset_gen
    val n = asset_nbytes
    var status_code: i64 = 0
    if (st == ASSET_ERROR) {
        status_code = asset_result
        if (status_code == 0) {
            status_code = 0 - 1
        }
    }
    if (st == ASSET_STALE) {
        status_code = 0 - 100
    }
    msg_push_asset(slot, status_code, gen, n)
    asset_status = ASSET_IDLE
    return 1
}

// --- OBJ mesh SoA (pos + UV + normals + triangle indices; ~20k verts / ~10k tris) ---
// Milli-unit storage (same pattern as engine.collision). Hot path: scalar getters.
// UV in [0,1] → milli 0..1000. Normals use signed milli (may be negative).

// Caps sized for dust2 cooked mesh (~12k verts / ~10k tris) + UV/normal SoA
// without exhausting jogrt's 4 MiB bump (struct-return Friction; no free).
val MESH_VERT_CAP: i64 = 12000
val MESH_TRI_CAP: i64 = 10000
val MESH_FILE_CAP: i64 = 1572864

var mesh_n_verts: i64 = 0
var mesh_n_tris: i64 = 0
var mesh_vx: *byte = null
var mesh_vy: *byte = null
var mesh_vz: *byte = null
var mesh_vu: *byte = null
var mesh_vv: *byte = null
var mesh_nx: *byte = null
var mesh_ny: *byte = null
var mesh_nz: *byte = null
var mesh_i0: *byte = null
var mesh_i1: *byte = null
var mesh_i2: *byte = null
var mesh_parse_f: f64 = 0.0
var mesh_parse_i: i64 = 0

fn mesh_poke64(p: *byte, i: i64, v: i64) {
    val off = i * 8
    p[off] = v & 255
    p[off + 1] = (v >> 8) & 255
    p[off + 2] = (v >> 16) & 255
    p[off + 3] = (v >> 24) & 255
    p[off + 4] = (v >> 32) & 255
    p[off + 5] = (v >> 40) & 255
    p[off + 6] = (v >> 48) & 255
    p[off + 7] = (v >> 56) & 255
}

fn mesh_peek64(p: *byte, i: i64): i64 {
    val off = i * 8
    val b0 = p[off] & 255
    val b1 = p[off + 1] & 255
    val b2 = p[off + 2] & 255
    val b3 = p[off + 3] & 255
    val b4 = p[off + 4] & 255
    val b5 = p[off + 5] & 255
    val b6 = p[off + 6] & 255
    val b7 = p[off + 7] & 255
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24) + (b4 << 32) + (b5 << 40) + (b6 << 48) + (b7 << 56)
}

fn mesh_pokef(p: *byte, i: i64, v: f64) {
    // Non-negative milli only — cook meshes into +octant (see dust2 cook).
    var milli = (v * 1.0 * 1000.0) as i64
    if (milli < 0) {
        milli = 0
    }
    mesh_poke64(p, i, milli)
}

fn mesh_peekf(p: *byte, i: i64): f64 {
    val milli = mesh_peek64(p, i)
    return (milli as f64) * 1.0 / 1000.0
}

fn mesh_pokef_signed(p: *byte, i: i64, v: f64) {
    // Signed milli for normals in [-1,1] (and similar).
    val milli = (v * 1.0 * 1000.0) as i64
    mesh_poke64(p, i, milli)
}

fn mesh_ensure_bufs(): i64 {
    if (mesh_vx != null) {
        return 1
    }
    mesh_vx = alloc(MESH_VERT_CAP * 8)
    mesh_vy = alloc(MESH_VERT_CAP * 8)
    mesh_vz = alloc(MESH_VERT_CAP * 8)
    mesh_vu = alloc(MESH_VERT_CAP * 8)
    mesh_vv = alloc(MESH_VERT_CAP * 8)
    mesh_nx = alloc(MESH_VERT_CAP * 8)
    mesh_ny = alloc(MESH_VERT_CAP * 8)
    mesh_nz = alloc(MESH_VERT_CAP * 8)
    mesh_i0 = alloc(MESH_TRI_CAP * 8)
    mesh_i1 = alloc(MESH_TRI_CAP * 8)
    mesh_i2 = alloc(MESH_TRI_CAP * 8)
    if (mesh_vx == null || mesh_vy == null || mesh_vz == null || mesh_vu == null || mesh_vv == null || mesh_nx == null || mesh_ny == null || mesh_nz == null || mesh_i0 == null || mesh_i1 == null || mesh_i2 == null) {
        return 0
    }
    return 1
}

fn mesh_vert_count(): i64 {
    return mesh_n_verts
}

fn mesh_tri_count(): i64 {
    return mesh_n_tris
}

fn mesh_get_vx(i: i64): f64 {
    return mesh_peekf(mesh_vx, i)
}

fn mesh_get_vy(i: i64): f64 {
    return mesh_peekf(mesh_vy, i)
}

fn mesh_get_vz(i: i64): f64 {
    return mesh_peekf(mesh_vz, i)
}

fn mesh_get_vu(i: i64): f64 {
    return mesh_peekf(mesh_vu, i)
}

fn mesh_get_vv(i: i64): f64 {
    return mesh_peekf(mesh_vv, i)
}

fn mesh_get_nx(i: i64): f64 {
    return mesh_peekf(mesh_nx, i)
}

fn mesh_get_ny(i: i64): f64 {
    return mesh_peekf(mesh_ny, i)
}

fn mesh_get_nz(i: i64): f64 {
    return mesh_peekf(mesh_nz, i)
}

fn mesh_get_i0(t: i64): i64 {
    return mesh_peek64(mesh_i0, t)
}

fn mesh_get_i1(t: i64): i64 {
    return mesh_peek64(mesh_i1, t)
}

fn mesh_get_i2(t: i64): i64 {
    return mesh_peek64(mesh_i2, t)
}

fn mesh_is_ws(b: i64): i64 {
    if (b == 32 || b == 9 || b == 10 || b == 13) {
        return 1
    }
    return 0
}

fn mesh_skip_ws(buf: *byte, n: i64, start: i64): i64 {
    var i = start
    while (i < n) {
        if (mesh_is_ws(buf[i]) == 0) {
            return i
        }
        i = i + 1
    }
    return i
}

// Parse decimal float into mesh_parse_f; returns next index or -1.
fn mesh_read_f64(buf: *byte, n: i64, start: i64): i64 {
    var i = mesh_skip_ws(buf, n, start)
    if (i >= n) {
        return 0 - 1
    }
    var sign = 1.0
    if (buf[i] == 45) {
        sign = 0.0 - 1.0
        i = i + 1
    } else {
        if (buf[i] == 43) {
            i = i + 1
        }
    }
    var int_part: f64 = 0.0
    var digits = 0
    while (i < n) {
        val b = buf[i]
        if (b < 48 || b > 57) {
            break
        }
        int_part = int_part * 10.0 + ((b - 48) as f64)
        digits = digits + 1
        i = i + 1
    }
    var frac: f64 = 0.0
    var place: f64 = 0.1
    if (i < n && buf[i] == 46) {
        i = i + 1
        while (i < n) {
            val b = buf[i]
            if (b < 48 || b > 57) {
                break
            }
            frac = frac + ((b - 48) as f64) * place
            place = place * 0.1
            digits = digits + 1
            i = i + 1
        }
    }
    if (digits == 0) {
        return 0 - 1
    }
    var exp_sign = 1
    var exp_v: i64 = 0
    if (i < n && (buf[i] == 101 || buf[i] == 69)) {
        i = i + 1
        if (i < n && buf[i] == 45) {
            exp_sign = 0 - 1
            i = i + 1
        } else {
            if (i < n && buf[i] == 43) {
                i = i + 1
            }
        }
        var ed = 0
        while (i < n) {
            val b = buf[i]
            if (b < 48 || b > 57) {
                break
            }
            exp_v = exp_v * 10 + (b - 48)
            ed = ed + 1
            i = i + 1
        }
        if (ed == 0) {
            return 0 - 1
        }
    }
    var v = sign * (int_part + frac)
    if (exp_v != 0) {
        var e = exp_v * exp_sign
        while (e > 0) {
            v = v * 10.0
            e = e - 1
        }
        while (e < 0) {
            v = v / 10.0
            e = e + 1
        }
    }
    mesh_parse_f = v
    return i
}

// Parse signed int into mesh_parse_i; returns next index or -1.
fn mesh_read_i64(buf: *byte, n: i64, start: i64): i64 {
    var i = mesh_skip_ws(buf, n, start)
    if (i >= n) {
        return 0 - 1
    }
    var sign: i64 = 1
    if (buf[i] == 45) {
        sign = 0 - 1
        i = i + 1
    } else {
        if (buf[i] == 43) {
            i = i + 1
        }
    }
    var v: i64 = 0
    var digits = 0
    while (i < n) {
        val b = buf[i]
        if (b < 48 || b > 57) {
            break
        }
        v = v * 10 + (b - 48)
        digits = digits + 1
        i = i + 1
    }
    if (digits == 0) {
        return 0 - 1
    }
    mesh_parse_i = v * sign
    return i
}

// Skip OBJ face corner after reading position index ( /vt /vn ).
fn mesh_skip_face_rest(buf: *byte, n: i64, start: i64): i64 {
    var i = start
    while (i < n) {
        val b = buf[i]
        if (mesh_is_ws(b) != 0) {
            return i
        }
        i = i + 1
    }
    return i
}

fn mesh_line_is(buf: *byte, n: i64, i: i64, c0: i64): i64 {
    if (i >= n) {
        return 0
    }
    if ((buf[i] & 255) != c0) {
        return 0
    }
    return 1
}

// Load Wavefront OBJ (v + optional vt/vn + triangulated f). Returns 0 on success.
// Cooked dust2 emits parallel v/vt/vn with f i/i/i — UV/normal SoA filled in file order.
// Old position-only OBJs keep default UV (0,0) and normal (0,0,1).
fn mesh_load_obj(path: *byte): i64 {
    if (mesh_ensure_bufs() == 0) {
        return 0 - 10
    }
    val raw = alloc(MESH_FILE_CAP)
    if (raw == null) {
        return 0 - 11
    }
    val n = tex_load_file(path, raw, MESH_FILE_CAP)
    if (n <= 0) {
        return 0 - 12
    }
    mesh_n_verts = 0
    mesh_n_tris = 0
    var n_uv: i64 = 0
    var n_n: i64 = 0
    var i: i64 = 0
    while (i < n) {
        // Start of line
        if (i > 0 && raw[i - 1] != 10 && i != 0) {
            // continue scanning for newline handled below
        }
        val c0 = raw[i] & 255
        if (c0 == 118 && i + 1 < n && (raw[i + 1] & 255) == 116 && i + 2 < n && mesh_is_ws(raw[i + 2]) != 0) {
            // "vt "
            var j = mesh_read_f64(raw, n, i + 2)
            if (j < 0) {
                return 0 - 24
            }
            val u = mesh_parse_f
            j = mesh_read_f64(raw, n, j)
            if (j < 0) {
                return 0 - 25
            }
            val vv = mesh_parse_f
            if (n_uv >= MESH_VERT_CAP) {
                return 0 - 26
            }
            mesh_pokef(mesh_vu, n_uv, u)
            mesh_pokef(mesh_vv, n_uv, vv)
            n_uv = n_uv + 1
            i = j
        } else {
            if (c0 == 118 && i + 1 < n && (raw[i + 1] & 255) == 110 && i + 2 < n && mesh_is_ws(raw[i + 2]) != 0) {
                // "vn "
                var j = mesh_read_f64(raw, n, i + 2)
                if (j < 0) {
                    return 0 - 27
                }
                val nx = mesh_parse_f
                j = mesh_read_f64(raw, n, j)
                if (j < 0) {
                    return 0 - 28
                }
                val ny = mesh_parse_f
                j = mesh_read_f64(raw, n, j)
                if (j < 0) {
                    return 0 - 29
                }
                val nz = mesh_parse_f
                if (n_n >= MESH_VERT_CAP) {
                    return 0 - 35
                }
                mesh_pokef_signed(mesh_nx, n_n, nx)
                mesh_pokef_signed(mesh_ny, n_n, ny)
                mesh_pokef_signed(mesh_nz, n_n, nz)
                n_n = n_n + 1
                i = j
            } else {
                if (c0 == 118 && i + 1 < n && mesh_is_ws(raw[i + 1]) != 0) {
                    // "v "
                    var j = mesh_read_f64(raw, n, i + 1)
                    if (j < 0) {
                        return 0 - 20
                    }
                    val x = mesh_parse_f
                    j = mesh_read_f64(raw, n, j)
                    if (j < 0) {
                        return 0 - 21
                    }
                    val y = mesh_parse_f
                    j = mesh_read_f64(raw, n, j)
                    if (j < 0) {
                        return 0 - 22
                    }
                    val z = mesh_parse_f
                    if (mesh_n_verts >= MESH_VERT_CAP) {
                        return 0 - 23
                    }
                    mesh_pokef(mesh_vx, mesh_n_verts, x)
                    mesh_pokef(mesh_vy, mesh_n_verts, y)
                    mesh_pokef(mesh_vz, mesh_n_verts, z)
                    // Defaults if file has no vt/vn (old OBJs).
                    mesh_pokef(mesh_vu, mesh_n_verts, 0.0)
                    mesh_pokef(mesh_vv, mesh_n_verts, 0.0)
                    mesh_pokef_signed(mesh_nx, mesh_n_verts, 0.0)
                    mesh_pokef_signed(mesh_ny, mesh_n_verts, 0.0)
                    mesh_pokef_signed(mesh_nz, mesh_n_verts, 1.0)
                    mesh_n_verts = mesh_n_verts + 1
                    i = j
                } else {
                    if (c0 == 102 && i + 1 < n && mesh_is_ws(raw[i + 1]) != 0) {
                        // "f " — expect 3 corners (cooked tris); position index only
                        // (cooked f i/i/i shares the same index for UV/normal).
                        var j = i + 1
                        j = mesh_read_i64(raw, n, j)
                        if (j < 0) {
                            return 0 - 30
                        }
                        var a = mesh_parse_i
                        j = mesh_skip_face_rest(raw, n, j)
                        j = mesh_read_i64(raw, n, j)
                        if (j < 0) {
                            return 0 - 31
                        }
                        var b = mesh_parse_i
                        j = mesh_skip_face_rest(raw, n, j)
                        j = mesh_read_i64(raw, n, j)
                        if (j < 0) {
                            return 0 - 32
                        }
                        var c = mesh_parse_i
                        j = mesh_skip_face_rest(raw, n, j)
                        // OBJ is 1-based
                        a = a - 1
                        b = b - 1
                        c = c - 1
                        if (a < 0 || b < 0 || c < 0 || a >= mesh_n_verts || b >= mesh_n_verts || c >= mesh_n_verts) {
                            return 0 - 33
                        }
                        if (mesh_n_tris >= MESH_TRI_CAP) {
                            return 0 - 34
                        }
                        mesh_poke64(mesh_i0, mesh_n_tris, a)
                        mesh_poke64(mesh_i1, mesh_n_tris, b)
                        mesh_poke64(mesh_i2, mesh_n_tris, c)
                        mesh_n_tris = mesh_n_tris + 1
                        i = j
                    }
                }
            }
        }
        // Advance to next line
        while (i < n && raw[i] != 10) {
            i = i + 1
        }
        if (i < n) {
            i = i + 1
        }
    }
    return 0
}
